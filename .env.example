# TradeQuery 环境变量配置
# 复制本文件为 .env 并填入真实值；.env 不提交到版本库
cp .env.example .env

# LLM API Key（必填，无 key 时 /api/chat 返回友好提示但不崩溃）
LLM_API_KEY=

# LLM Base URL（默认 Gemini 兼容 OpenAI 的 endpoint）
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# LLM 模型（默认 gemini-3.8-flash；Google 已下架 gemini-2.5-flash）
LLM_MODEL=gemini-3.8-flash

# 服务端口
PORT=8000
