# TradeQuery 环境变量配置
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 不提交到版本库

# ---------- 界面与问答语言 ----------
# en = 英文版（默认，线上演示站用这个）；zh = 中文版
APP_LANG=en

# ---------- LLM 配置 ----------
# LLM API Key（必填，无 key 时 /api/chat 返回友好提示但不崩溃）
LLM_API_KEY=

# LLM Base URL（默认 Gemini 兼容 OpenAI 的 endpoint；换 OpenAI/其他兼容服务改这里）
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# LLM 模型（默认 gemini-3.5-flash-lite，实测最稳定；备选 gemini-3.8-flash）
LLM_MODEL=gemini-3.5-flash-lite

# ---------- 数据库配置 ----------
# 默认 SQLite（零配置，数据文件在 backend/db/trade.db，首次启动自动建表+灌演示数据）
DATABASE_URL=sqlite:///./backend/db/trade.db

# PostgreSQL 示例（需要先建库；生产环境请用只授 SELECT 权限的账号）：
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/tradequery

# MySQL 示例（需要先建库并设 utf8mb4；生产环境请用只授 SELECT 权限的账号）：
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/tradequery

# SQL 方言：sqlite / postgresql / mysql
# 留空则从 DATABASE_URL 自动推导；显式设置优先级最高
# SQL_DIALECT=sqlite

# ---------- 服务端口 ----------
PORT=8000
